# Copy to .env (git-ignored) and fill in. Never commit real values.
# Scripts read these as environment variables; ui/server.py and verify/v4_agent.py also read .env directly.
# One KEY=VALUE per line; no inline comments (a value may legitimately contain '#').

# Local Exasol Personal. nocertcheck only for the local self-signed certificate.
EXA_DSN=127.0.0.1/nocertcheck:8563
# Admin user: used only by the two setup scripts in agent/.
EXA_USER=sys
EXA_PASSWORD=change-me
# The user the app runs as, created by agent/setup_app_user.py. It owns RAW, RECON, AUDIT and VERIFIER and nothing else.
TATGUARD_APP_USER=TATGUARD_APP
TATGUARD_APP_PASSWORD=change-me-also-12chars
# Read-only user created by agent/setup_agent_user.py (12+ chars of A-Z a-z 0-9 _-.!@#%^*+=).
TATGUARD_AGENT_USER=TATGUARD_AGENT
TATGUARD_AGENT_PASSWORD=change-me-too-12chars
# Which instance produced the timings in reports/timings.csv.
TATGUARD_HOST_LABEL=exasol-personal-local
# Enables the AI analyst (key from Google AI Studio). Without it, Ask offers three prepared questions and says so.
# GEMINI_API_KEY=
# Optional: Gemini models, tried in turn when one is busy. TATGUARD_LLM=off forces the prepared questions.
# TATGUARD_MODEL=gemini-2.5-flash,gemini-3-flash-preview,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite
# TATGUARD_LLM=off
# Optional: UI port (default 8765).
# TATGUARD_UI_PORT=8765
# Public mode, normally set by scripts/go_public.sh. The code gates every API call; the hosts are the public names allowed
# (".example.com" means any host under it). Idle minutes before the demo resets itself; 0 turns that off.
# TATGUARD_ACCESS_CODE=
# TATGUARD_PUBLIC_HOST=.trycloudflare.com
# TATGUARD_IDLE_RESET_MIN=30
# Optional: which dataset the Live page's late file and reset read (default data/1m).
# TATGUARD_DATA=data/1m
